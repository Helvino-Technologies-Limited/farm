generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  ADMIN
  MANAGER
  SALES
  CASHIER
  ACCOUNTANT
  PRODUCTION
  POULTRY
  STOREKEEPER
  PROCUREMENT
  DELIVERY
  MANAGEMENT
}

enum SalesCentre {
  SEEDLINGS
  FIELD_VEGETABLES
  CROPS
  FRUITS
  POULTRY
  DAIRY
  FEEDS
  ANIMAL_PRODUCTION
  DRIP_INSTALLATION
  WATER
  TRAINING_ADVISORY
  OTHER
}

enum PriceRuleType {
  FIXED
  AGE_BASED
  STAGE_BASED
  QUANTITY_BASED
  CUSTOMER_SPECIFIC
  PROMOTIONAL
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  PARTIALLY_PAID
  FULLY_PAID
  READY
  COMPLETED
  CANCELLED
}

enum SaleStatus {
  COMPLETED
  VOIDED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  MPESA
  BANK
  CARD
  CHEQUE
  OTHER
}

enum PaymentStatus {
  COMPLETED
  REVERSED
}

enum ExpenseStatus {
  PENDING
  MANAGER_REVIEW
  APPROVED
  REJECTED
  POSTED
}

enum InventoryTxnType {
  OPENING
  PURCHASE
  PRODUCTION
  SALE
  MORTALITY
  WASTAGE
  DAMAGE
  ADJUSTMENT
  RETURN
  TRANSFER
  ISSUE
}

enum StockAdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PoultryBatchStatus {
  ACTIVE
  CLOSED
}

enum CashSessionStatus {
  OPEN
  SUBMITTED
  VERIFIED
}

enum AuditAction {
  CREATE
  UPDATE
  APPROVE
  REJECT
  VOID
  LOGIN
  LOGOUT
  PAYMENT
  STOCK_ADJUSTMENT
  PRICE_CHANGE
}

// ============================================================
// IDENTITY
// ============================================================

model User {
  id           String    @id @default(cuid())
  employeeNo   String?   @unique
  name         String
  email        String    @unique
  passwordHash String
  role         Role
  active       Boolean   @default(true)
  failedAttempts Int     @default(0)
  lockedUntil    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions Session[]

  createdCustomers   Customer[]           @relation("CustomerCreatedBy")
  createdProducts    Product[]            @relation("ProductCreatedBy")
  createdPriceRules  PriceRule[]          @relation("PriceRuleCreatedBy")
  approvedPriceRules PriceRule[]          @relation("PriceRuleApprovedBy")
  poultryBatches     PoultryBatch[]       @relation("PoultryBatchCreatedBy")
  mortalityRecords   PoultryMortality[]   @relation("MortalityRecordedBy")
  feedRecords        PoultryFeedRecord[]  @relation("FeedRecordedBy")
  quotations         Quotation[]          @relation("QuotationCreatedBy")
  bookings           Booking[]            @relation("BookingCreatedBy")
  sales              Sale[]               @relation("SaleCreatedBy")
  invoices           Invoice[]            @relation("InvoiceCreatedBy")
  payments           Payment[]            @relation("PaymentReceivedBy")
  stockAdjRequested  StockAdjustment[]    @relation("StockAdjRequestedBy")
  stockAdjApproved   StockAdjustment[]    @relation("StockAdjApprovedBy")
  stockCounts        StockCount[]         @relation("StockCountCreatedBy")
  expensesRequested  Expense[]            @relation("ExpenseRequestedBy")
  expensesReviewed   Expense[]            @relation("ExpenseReviewedBy")
  cashSessionsOpened CashSession[]        @relation("CashSessionOpenedBy")
  cashSessionsVerify CashSession[]        @relation("CashSessionVerifiedBy")
  auditLogs          AuditLog[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName  String
  action    AuditAction
  module    String
  recordId  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  device    String?
  createdAt DateTime    @default(now())

  @@index([module, recordId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// MASTER DATA
// ============================================================

model Customer {
  id             String   @id @default(cuid())
  customerNumber String   @unique
  name           String
  phone          String
  email          String?  @unique
  location       String?
  address        String?
  customerType   String   @default("RETAIL")
  creditLimit    Decimal  @default(0) @db.Decimal(14, 2)
  status         String   @default("ACTIVE")
  registeredAt   DateTime @default(now())
  createdById    String
  createdBy      User     @relation("CustomerCreatedBy", fields: [createdById], references: [id])

  // Customer self-service portal login (null until they register / an admin sets a password)
  passwordHash String?
  portalActive Boolean  @default(true)

  quotations Quotation[]
  bookings   Booking[]
  sales      Sale[]
  invoices   Invoice[]
  payments   Payment[]
  priceRules PriceRule[]
  sessions   CustomerSession[]

  @@index([name])
  @@map("customers")
}

model CustomerSession {
  id         String   @id @default(cuid())
  token      String   @unique
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([customerId])
  @@map("customer_sessions")
}

model ProductCategory {
  id          String      @id @default(cuid())
  name        String      @unique
  code        String      @unique
  salesCentre SalesCentre
  description String?

  products Product[]

  @@map("product_categories")
}

model Unit {
  id           String @id @default(cuid())
  name         String @unique
  abbreviation String @unique

  products Product[]

  @@map("units")
}

model Product {
  id             String   @id @default(cuid())
  sku            String   @unique
  name           String
  categoryId     String
  category       ProductCategory @relation(fields: [categoryId], references: [id])
  subcategory    String?
  description    String?
  unitId         String
  unit           Unit     @relation(fields: [unitId], references: [id])
  costPrice      Decimal  @default(0) @db.Decimal(14, 2)
  sellingPrice   Decimal  @default(0) @db.Decimal(14, 2)
  minimumStock   Decimal  @default(0) @db.Decimal(12, 3)
  reorderLevel   Decimal  @default(0) @db.Decimal(12, 3)
  maximumStock   Decimal? @db.Decimal(12, 3)
  active         Boolean  @default(true)
  trackInventory Boolean  @default(true)
  isPoultry      Boolean  @default(false)
  imageUrl       String?  @db.Text
  videoUrl       String?  @db.Text
  publiclyListed Boolean  @default(true)
  createdById    String
  createdBy      User     @relation("ProductCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  priceRules           PriceRule[]
  poultryBatches       PoultryBatch[]
  quotationItems       QuotationItem[]
  bookingItems         BookingItem[]
  saleItems            SaleItem[]
  invoiceItems         InvoiceItem[]
  inventoryTransactions InventoryTransaction[]
  stockCountItems      StockCountItem[]
  stockAdjustments     StockAdjustment[]

  @@index([categoryId])
  @@map("products")
}

model PriceRule {
  id             String        @id @default(cuid())
  productId      String
  product        Product       @relation(fields: [productId], references: [id])
  type           PriceRuleType
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id])
  minQty         Decimal?      @db.Decimal(12, 3)
  maxQty         Decimal?      @db.Decimal(12, 3)
  price          Decimal       @db.Decimal(14, 2)
  effectiveFrom  DateTime      @default(now())
  effectiveTo    DateTime?
  active         Boolean       @default(true)
  createdById    String
  createdBy      User          @relation("PriceRuleCreatedBy", fields: [createdById], references: [id])
  approvedById   String?
  approvedBy     User?         @relation("PriceRuleApprovedBy", fields: [approvedById], references: [id])
  createdAt      DateTime      @default(now())

  @@index([productId])
  @@map("price_rules")
}

// ============================================================
// POULTRY
// ============================================================

model PoultryBatch {
  id               String             @id @default(cuid())
  batchNumber      String             @unique
  breed            String
  source           String?
  hatchDate        DateTime
  initialQuantity  Int
  productId        String
  product          Product            @relation(fields: [productId], references: [id])
  status           PoultryBatchStatus @default(ACTIVE)
  notes            String?
  createdById      String
  createdBy        User               @relation("PoultryBatchCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime           @default(now())

  ageRules    PoultryAgePriceRule[]
  mortality   PoultryMortality[]
  feedRecords PoultryFeedRecord[]
  saleItems   SaleItem[]
  bookingItems BookingItem[]

  @@map("poultry_batches")
}

model PoultryAgePriceRule {
  id         String        @id @default(cuid())
  batchId    String?
  batch      PoultryBatch? @relation(fields: [batchId], references: [id], onDelete: Cascade)
  breed      String?
  label      String
  minAgeDays Int
  maxAgeDays Int?
  price      Decimal       @db.Decimal(14, 2)
  createdAt  DateTime      @default(now())

  @@index([batchId])
  @@index([breed])
  @@map("poultry_age_price_rules")
}

model PoultryMortality {
  id           String       @id @default(cuid())
  batchId      String
  batch        PoultryBatch @relation(fields: [batchId], references: [id])
  date         DateTime     @default(now())
  quantity     Int
  cause        String
  remarks      String?
  recordedById String
  recordedBy   User         @relation("MortalityRecordedBy", fields: [recordedById], references: [id])
  createdAt    DateTime     @default(now())

  @@index([batchId])
  @@map("poultry_mortality")
}

model PoultryFeedRecord {
  id           String       @id @default(cuid())
  batchId      String
  batch        PoultryBatch @relation(fields: [batchId], references: [id])
  feedType     String
  quantity     Decimal      @db.Decimal(12, 3)
  unit         String
  cost         Decimal?     @db.Decimal(14, 2)
  date         DateTime     @default(now())
  recordedById String
  recordedBy   User         @relation("FeedRecordedBy", fields: [recordedById], references: [id])
  createdAt    DateTime     @default(now())

  @@index([batchId])
  @@map("poultry_feed_records")
}

// ============================================================
// SALES CHAIN
// ============================================================

model Quotation {
  id                String          @id @default(cuid())
  quotationNumber   String          @unique
  customerId        String
  customer          Customer        @relation(fields: [customerId], references: [id])
  validUntil        DateTime
  status            QuotationStatus @default(DRAFT)
  subtotal          Decimal         @db.Decimal(14, 2)
  discount          Decimal         @default(0) @db.Decimal(14, 2)
  total             Decimal         @db.Decimal(14, 2)
  terms             String?
  createdById       String
  createdBy         User            @relation("QuotationCreatedBy", fields: [createdById], references: [id])
  createdAt         DateTime        @default(now())

  items    QuotationItem[]
  bookings Booking[]
  sales    Sale[]

  @@map("quotations")
}

model QuotationItem {
  id           String    @id @default(cuid())
  quotationId  String
  quotation    Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId    String
  product      Product   @relation(fields: [productId], references: [id])
  description  String?
  quantity     Decimal   @db.Decimal(12, 3)
  unitPrice    Decimal   @db.Decimal(14, 2)
  discount     Decimal   @default(0) @db.Decimal(14, 2)
  total        Decimal   @db.Decimal(14, 2)

  @@map("quotation_items")
}

model Booking {
  id             String        @id @default(cuid())
  bookingNumber  String        @unique
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  quotationId    String?
  quotation      Quotation?    @relation(fields: [quotationId], references: [id])
  bookingDate    DateTime      @default(now())
  requiredDate   DateTime?
  deliveryMethod String        @default("COLLECTION")
  depositAmount  Decimal       @default(0) @db.Decimal(14, 2)
  totalAmount    Decimal       @db.Decimal(14, 2)
  status         BookingStatus @default(PENDING)
  notes          String?
  createdById    String
  createdBy      User          @relation("BookingCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime      @default(now())

  items    BookingItem[]
  sales    Sale[]
  invoices Invoice[]

  @@map("bookings")
}

model BookingItem {
  id             String        @id @default(cuid())
  bookingId      String
  booking        Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  productId      String
  product        Product       @relation(fields: [productId], references: [id])
  poultryBatchId String?
  poultryBatch   PoultryBatch? @relation(fields: [poultryBatchId], references: [id])
  quantity       Decimal       @db.Decimal(12, 3)
  unitPrice      Decimal       @db.Decimal(14, 2)
  total          Decimal       @db.Decimal(14, 2)

  @@index([productId])
  @@index([poultryBatchId])
  @@map("booking_items")
}

model Sale {
  id            String      @id @default(cuid())
  saleNumber    String      @unique
  customerId    String
  customer      Customer    @relation(fields: [customerId], references: [id])
  salesCentre   SalesCentre
  saleDate      DateTime    @default(now())
  paymentMethod PaymentMethod?
  subtotal      Decimal     @db.Decimal(14, 2)
  discount      Decimal     @default(0) @db.Decimal(14, 2)
  total         Decimal     @db.Decimal(14, 2)
  amountPaid    Decimal     @default(0) @db.Decimal(14, 2)
  balance       Decimal     @default(0) @db.Decimal(14, 2)
  status        SaleStatus  @default(COMPLETED)
  voidReason    String?
  bookingId     String?
  booking       Booking?    @relation(fields: [bookingId], references: [id])
  quotationId   String?
  quotation     Quotation?  @relation(fields: [quotationId], references: [id])
  createdById   String
  createdBy     User        @relation("SaleCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime    @default(now())

  items    SaleItem[]
  invoice  Invoice?

  @@index([saleDate])
  @@index([salesCentre])
  @@map("sales")
}

model SaleItem {
  id             String        @id @default(cuid())
  saleId         String
  sale           Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId      String
  product        Product       @relation(fields: [productId], references: [id])
  poultryBatchId String?
  poultryBatch   PoultryBatch? @relation(fields: [poultryBatchId], references: [id])
  description    String?
  quantity       Decimal       @db.Decimal(12, 3)
  unit           String
  unitPrice      Decimal       @db.Decimal(14, 2)
  discount       Decimal       @default(0) @db.Decimal(14, 2)
  total          Decimal       @db.Decimal(14, 2)

  @@index([productId])
  @@index([poultryBatchId])
  @@map("sale_items")
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  saleId        String?       @unique
  sale          Sale?         @relation(fields: [saleId], references: [id])
  bookingId     String?
  booking       Booking?      @relation(fields: [bookingId], references: [id])
  invoiceDate   DateTime      @default(now())
  dueDate       DateTime?
  subtotal      Decimal       @db.Decimal(14, 2)
  discount      Decimal       @default(0) @db.Decimal(14, 2)
  total         Decimal       @db.Decimal(14, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(14, 2)
  balance       Decimal       @db.Decimal(14, 2)
  status        InvoiceStatus @default(ISSUED)
  cancelReason  String?
  createdById   String
  createdBy     User          @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime      @default(now())

  items       InvoiceItem[]
  allocations PaymentAllocation[]

  @@index([customerId])
  @@index([status])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  description String
  quantity    Decimal @db.Decimal(12, 3)
  unitPrice   Decimal @db.Decimal(14, 2)
  discount    Decimal @default(0) @db.Decimal(14, 2)
  total       Decimal @db.Decimal(14, 2)

  @@map("invoice_items")
}

model Payment {
  id                 String        @id @default(cuid())
  paymentNumber      String        @unique
  customerId         String
  customer           Customer      @relation(fields: [customerId], references: [id])
  amount             Decimal       @db.Decimal(14, 2)
  method             PaymentMethod
  transactionReference String?
  paymentDate        DateTime      @default(now())
  receivedById       String
  receivedBy         User          @relation("PaymentReceivedBy", fields: [receivedById], references: [id])
  notes              String?
  status             PaymentStatus @default(COMPLETED)
  reversalReason     String?
  reversedAt         DateTime?
  cashSessionId      String?
  cashSession        CashSession?  @relation(fields: [cashSessionId], references: [id])
  createdAt          DateTime      @default(now())

  allocations PaymentAllocation[]

  @@index([customerId])
  @@index([paymentDate])
  @@map("payments")
}

model PaymentAllocation {
  id        String   @id @default(cuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  amount    Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@map("payment_allocations")
}

// ============================================================
// INVENTORY
// ============================================================

model InventoryTransaction {
  id           String            @id @default(cuid())
  productId    String
  product      Product           @relation(fields: [productId], references: [id])
  type         InventoryTxnType
  quantity     Decimal           @db.Decimal(12, 3)
  unitCost     Decimal?          @db.Decimal(14, 2)
  reference    String?
  referenceId  String?
  notes        String?
  recordedById String
  createdAt    DateTime          @default(now())

  @@index([productId])
  @@index([type])
  @@index([createdAt])
  @@map("inventory_transactions")
}

model StockCount {
  id          String   @id @default(cuid())
  countNumber String   @unique
  countDate   DateTime @default(now())
  status      String   @default("DRAFT")
  createdById String
  createdBy   User     @relation("StockCountCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  items StockCountItem[]

  @@map("stock_counts")
}

model StockCountItem {
  id               String     @id @default(cuid())
  stockCountId     String
  stockCount       StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  productId        String
  product          Product    @relation(fields: [productId], references: [id])
  systemQuantity   Decimal    @db.Decimal(12, 3)
  countedQuantity  Decimal    @db.Decimal(12, 3)
  variance         Decimal    @db.Decimal(12, 3)
  notes            String?

  @@map("stock_count_items")
}

model StockAdjustment {
  id               String                 @id @default(cuid())
  adjustmentNumber String                 @unique
  productId        String
  product          Product                @relation(fields: [productId], references: [id])
  quantity         Decimal                @db.Decimal(12, 3)
  reason           String
  status           StockAdjustmentStatus  @default(PENDING)
  requestedById    String
  requestedBy      User                   @relation("StockAdjRequestedBy", fields: [requestedById], references: [id])
  approvedById     String?
  approvedBy       User?                  @relation("StockAdjApprovedBy", fields: [approvedById], references: [id])
  approvedAt       DateTime?
  createdAt        DateTime               @default(now())

  @@map("stock_adjustments")
}

// ============================================================
// FINANCE
// ============================================================

model ExpenseCategory {
  id          String @id @default(cuid())
  name        String @unique
  description String?

  expenses Expense[]

  @@map("expense_categories")
}

model Expense {
  id               String        @id @default(cuid())
  expenseNumber    String        @unique
  categoryId       String
  category         ExpenseCategory @relation(fields: [categoryId], references: [id])
  amount           Decimal       @db.Decimal(14, 2)
  description      String?
  date             DateTime      @default(now())
  paymentMethod    PaymentMethod?
  attachmentUrl    String?
  status           ExpenseStatus @default(PENDING)
  requestedById    String
  requestedBy      User          @relation("ExpenseRequestedBy", fields: [requestedById], references: [id])
  reviewedById     String?
  reviewedBy       User?         @relation("ExpenseReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt       DateTime?
  rejectionReason  String?
  cashSessionId    String?
  cashSession      CashSession?  @relation(fields: [cashSessionId], references: [id])
  createdAt        DateTime      @default(now())

  @@index([status])
  @@index([date])
  @@map("expenses")
}

model CashSession {
  id                  String            @id @default(cuid())
  sessionNumber       String            @unique
  openedById          String
  openedBy            User              @relation("CashSessionOpenedBy", fields: [openedById], references: [id])
  openedAt            DateTime          @default(now())
  openingCash         Decimal           @db.Decimal(14, 2)
  closedAt            DateTime?
  closingActualCash   Decimal?          @db.Decimal(14, 2)
  status              CashSessionStatus @default(OPEN)
  verifiedById        String?
  verifiedBy          User?             @relation("CashSessionVerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt          DateTime?
  variance            Decimal?          @db.Decimal(14, 2)
  notes               String?

  payments Payment[]
  expenses Expense[]

  @@map("cash_sessions")
}

// ============================================================
// SYSTEM
// ============================================================

model DocumentSequence {
  id         String @id @default(cuid())
  key        String @unique
  prefix     String
  nextNumber Int    @default(1)

  @@map("document_sequences")
}

model SystemSetting {
  id                        Int      @id @default(1)
  farmName                  String   @default("Avepo Smart Farm")
  logoUrl                   String?  @db.Text
  address                   String?
  phone                     String?
  email                     String?
  location                  String?
  currency                  String   @default("KES")
  defaultDiscountLimit      Decimal  @default(0) @db.Decimal(5, 2)
  creditSaleRequiresApproval Boolean @default(true)
  updatedAt                 DateTime @updatedAt

  @@map("system_settings")
}
